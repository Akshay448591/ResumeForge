NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/resumeforge
# At least 16 characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Job tailoring and the bullet assistant (needs a Gemini API key).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# PDF export (optional). The renderer opens the web app's /print page in headless Chromium.
# Defaults: http://localhost:5173 in development, this server in production.
# PRINT_BASE_URL=http://localhost:5173
# Use an existing Chrome/Chromium instead of the one from `npm run pdf:setup`:
# CHROMIUM_PATH=
# Extra Chromium flags, separated by spaces (for example --no-sandbox inside Docker):
# CHROMIUM_ARGS=
